# Docker defaults. Copy this file to .env at the repository root.
DATABASE_URL=postgresql+asyncpg://readme:readme@db:5432/readme_ai
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional server token for public lookups; never used to publish as a visitor.
GITHUB_TOKEN=
# Generate using the command in docs/SETUP.md. Required only for OAuth.
TOKEN_ENCRYPTION_KEY=
REDIS_URL=redis://redis:6379/0
COOKIE_SECURE=false
AI_DAILY_LIMIT=30
REQUEST_LIMIT_PER_MINUTE=90
SESSION_HOURS=12
